---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MediaCard from '../components/MediaCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { mediaItems } from '../lib/data';
const categories = [...new Set(mediaItems.map((m) => m.category))];
---
<Base title="Press" description="Interviews, profiles, podcasts and videos featuring Brian Aseli, linked to the original publishers.">
  <PageHero kicker="Press" title="In the press and on the record." lede="Interviews, profiles and broadcasts, each linked to its original publisher. Coverage isn't an endorsement of my services by the publishers listed." stage="hexsphere" word="PRESS" />
  <section class="room section" aria-labelledby="a-h">
    <div class="wrap">
      <h2 id="a-h" class="sr-only">Press archive</h2>
      <FilterBar target="media-list" categories={categories} search label="Filter by category" noun="items" />
      <div id="media-list" class="grid grid--3">
        {mediaItems.map((m) => <div data-category={m.category} data-search={`${m.title} ${m.publisher} ${m.summary} ${m.role} ${m.displayDate}`.toLowerCase()}><MediaCard item={m} /></div>)}
      </div>
      <p data-empty hidden class="muted empty">No items match. Try another word or clear the filter.</p>
      <p class="note muted">Journalists and producers: interview requests go through the <a class="text-link" href="/contact/?service=Media%20or%20interview%20request">enquiry form</a>. Approved bios and portraits are in the <a class="text-link" href="/media-kit/">media kit</a>.</p>
    </div>
  </section>
</Base>
<style>.empty { padding-block: 2rem; } .note { margin-top: 3rem; max-width: 70ch; }</style>
