---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Rail from '../components/Rail.astro';
import VideoCard from '../components/VideoCard.astro';
import { site, videos, videoGroup, showreelReady } from '../lib/data';
import { photos, stages, thumbs, type PhotoKey } from '../lib/photos';

const featured = showreelReady
  ? { id: site.showreel.youtubeId as string, title: site.showreel.title, kicker: 'Showreel', text: site.showreel.description }
  : (() => { const v = videos[0]; return { id: v.youtubeId!, title: v.title, kicker: 'Featured conversation', text: v.summary }; })();
const conversations = videoGroup('conversations').filter((v) => v.youtubeId !== featured.id);
const onAir = videoGroup('on-air');
const gallery: { key: PhotoKey; cap: string }[] = [
  { key: 'event-night', cap: 'At an evening event, Nairobi' },
  { key: 'portrait-leather', cap: 'Editorial portrait' },
  { key: 'frame-hands', cap: 'Editorial portrait' },
  { key: 'portrait-suit', cap: 'Editorial portrait' },
  { key: 'stage-mic', cap: 'On stage' },
  { key: 'portrait-thinking', cap: 'Studio portrait' },
  { key: 'portrait-laugh', cap: 'Studio portrait' },
  { key: 'portrait-black-tee', cap: 'Studio portrait' },
  { key: 'portrait-smile', cap: 'Studio portrait' },
];
const videoSchema = videos.map((v) => ({ '@context': 'https://schema.org', '@type': 'VideoObject', name: v.title, description: v.summary,
  thumbnailUrl: `https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`, ...(v.publishedDate ? { uploadDate: v.publishedDate } : {}),
  embedUrl: `https://www.youtube-nocookie.com/embed/${v.youtubeId}`, contentUrl: `https://www.youtube.com/watch?v=${v.youtubeId}` }));
---
<Base title="Watch" description="Videos and photographs of Brian Aseli: conversations, on-air moments and portraits." schema={videoSchema}>
  <PageHero kicker="Watch" title="Watch me in action." lede="Conversations, on-air moments and photographs. Press play." stage="sparkle" word="LIVE" />

  <section id="showreel" class="stage section feat" aria-labelledby="feat-h">
    <div class="wrap feat-grid">
      <button type="button" class="feat-media" data-video={featured.id} data-video-title={featured.title} aria-label={`Play video: ${featured.title}`}>
        {thumbs[featured.id]
          ? <Image src={thumbs[featured.id]} alt="" widths={[700, 1100, 1280]} sizes="(min-width: 960px) 60vw, 92vw" loading="lazy" />
          : <Image src={stages.podium} alt="" widths={[700, 1200]} sizes="(min-width: 960px) 60vw, 92vw" loading="lazy" />}
        <span class="big-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
      </button>
      <div class="feat-copy">
        <p class="kicker">{featured.kicker}</p>
        <h2 id="feat-h" class="h2" data-split>{featured.title}</h2>
        <p class="muted">{featured.text}</p>
      </div>
    </div>
  </section>

  {conversations.length > 0 && (
    <section class="room section" aria-labelledby="conv-h">
      <Rail label="Conversations" id="conv-rail">
        <div slot="head"><p class="kicker">In conversation</p><h2 id="conv-h" class="h2">Interviews and features</h2></div>
        {conversations.map((v, i) => <VideoCard id={v.youtubeId!} title={v.title} source={(v as any).videoGroup === 'on-air' ? 'On air' : 'In conversation'} date={v.publishedDate ? v.displayDate : undefined} />)}
      </Rail>
    </section>
  )}

  <section class="room-2 section" aria-labelledby="air-h">
    <Rail label="On-air moments" id="air-rail">
      <div slot="head"><p class="kicker">On air</p><h2 id="air-h" class="h2">Moments from the studio</h2></div>
      {onAir.map((v, i) => <VideoCard id={v.youtubeId!} title={v.title} source={(v as any).videoGroup === 'on-air' ? 'On air' : 'In conversation'} date={v.publishedDate ? v.displayDate : undefined} />)}
    </Rail>
  </section>

  <section class="room section" aria-labelledby="ph-h">
    <div class="wrap">
      <div class="head head--split">
        <div><p class="kicker">Photographs</p><h2 id="ph-h" class="h1" data-split>In the room and in the studio.</h2></div>
        <p class="lede">Select a photo to view it full size.</p>
      </div>
      <ul class="gallery">
        {gallery.map((g, i) => (
          <li class={`g g${i}`}>
            <button type="button" class="g-btn" data-lightbox={i} aria-label={`View larger: ${photos[g.key].alt}`}>
              <Image src={photos[g.key].src} alt={photos[g.key].alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 46vw" style={`object-position:${photos[g.key].pos}`} loading="lazy" />
              <span class="g-cap">{g.cap}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lb aria-label="Photo viewer">
    {gallery.map((g, i) => (
      <figure class="lb-fig" data-lb-fig={i} hidden>
        <Image src={photos[g.key].src} alt={photos[g.key].alt} widths={[1000, 1600]} sizes="92vw" loading="lazy" />
        <figcaption>{g.cap}</figcaption>
      </figure>
    ))}
    <div class="lb-ctrls">
      <button type="button" class="icon-btn" data-lb-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="icon-btn" data-lb-next aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="btn btn--primary" data-lb-close>Close</button>
    </div>
  </dialog>
</Base>
<style>
  .feat-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 960px) { .feat-grid { grid-template-columns: 1.7fr 1fr; gap: 3.5rem; } }
  .feat-media { all: unset; cursor: pointer; position: relative; display: block; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: var(--stage-2); box-shadow: 0 40px 100px -40px rgba(61,123,255,.5); }
  .feat-media:focus-visible { outline: 3px solid var(--copper); outline-offset: 4px; }
  .feat-media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .feat-media:hover :global(img) { transform: scale(1.04); }
  .big-play { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; background: var(--copper); color: var(--stage); animation: pulse 2.4s var(--ease) infinite; }
  .big-play svg { width: 36px; height: 36px; margin-left: 5px; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(240,120,50,.55); } 70% { box-shadow: 0 0 0 26px rgba(240,120,50,0); } 100% { box-shadow: 0 0 0 0 rgba(240,120,50,0); } }
  .feat-copy { display: grid; gap: 1rem; }
  .gallery { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .g0 { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .gallery { grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(220px, 19vw, 300px); grid-auto-flow: dense; }
    .g0 { grid-column: span 2; grid-row: span 2; }
    .g3 { grid-row: span 2; }
    .g4 { grid-row: span 2; }
    .g6, .g8 { grid-column: span 2; }
  }
  .g-btn { all: unset; cursor: zoom-in; position: relative; display: block; width: 100%; height: 100%; min-height: 220px; border-radius: var(--r-md); overflow: hidden; background: var(--stage); }
  @media (max-width: 899px) { .g-btn { aspect-ratio: 4 / 5; min-height: 0; } .g0 .g-btn { aspect-ratio: 3 / 2; } }
  .g-btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .g-btn :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .g-btn:hover :global(img) { transform: scale(1.06); }
  .g-cap { position: absolute; left: .8rem; bottom: .8rem; padding: .3em .8em; border-radius: 999px; background: rgba(5,11,28,.82); color: var(--ivory); font-size: .8rem; font-weight: 700; }
  .lightbox { width: min(1100px, 94vw); max-height: 94vh; border: 0; padding: 1rem; border-radius: var(--r-lg); background: var(--stage); color: var(--ivory); }
  .lightbox::backdrop { background: rgba(3,7,18,.9); backdrop-filter: blur(6px); }
  .lb-fig :global(img) { width: 100%; max-height: 76vh; object-fit: contain; border-radius: var(--r-md); }
  .lb-fig figcaption { margin-top: .6rem; color: var(--mist); font-size: .9rem; }
  .lb-ctrls { display: flex; gap: .6rem; justify-content: flex-end; align-items: center; margin-top: .8rem; }
  .lb-ctrls .icon-btn { color: var(--ivory); border-color: var(--stage-line); }
</style>
<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const figs = [...lb.querySelectorAll<HTMLElement>('[data-lb-fig]')];
  let cur = 0, opener: HTMLElement | null = null;
  const show = (n: number) => { cur = (n + figs.length) % figs.length; figs.forEach((f, i) => (f.hidden = i !== cur)); };
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) => b.addEventListener('click', () => { opener = b; show(Number(b.dataset.lightbox)); lb.showModal(); }));
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(cur + 1));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(cur + 1); if (e.key === 'ArrowLeft') show(cur - 1); });
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => opener?.focus());
</script>
